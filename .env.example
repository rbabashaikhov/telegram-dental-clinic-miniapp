# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
PORT=3000

# SQLite path. Docker / VPS: /data/dental.db with a volume mounted at /data
DATABASE_PATH=

# Telegram Bot token from @BotFather (required for production initData validation)
TELEGRAM_BOT_TOKEN=

# When true (or when TELEGRAM_BOT_TOKEN is empty), browser demo mode is allowed
ALLOW_DEMO_MODE=true

TZ=Europe/Moscow
PUBLIC_DIR=
VITE_API_URL=

BUSINESS_NAME=DentalCare
APP_TITLE=DentalCare
APP_DESCRIPTION=Личный кабинет стоматологической клиники: план лечения, зубная карта и запись на этапы.
BRAND_ACCENT=#1B6B63
BRAND_LOGO_URL=

# local = SQLite is the source of truth. external = CRM/PMS stub (501 until an adapter exists).
DATA_MODE=local

# local | webhook | mock
EVENT_ADAPTER=local
EVENT_WEBHOOK_URL=
EVENT_WEBHOOK_SECRET=
EVENT_WEBHOOK_TIMEOUT_MS=5000

# local | mock
NOTIFICATION_ADAPTER=local

# mock | external
PAYMENT_ADAPTER=mock

FEATURE_DEMO_TOUR=true
FEATURE_DEMO_ADMIN_PREVIEW=true

# Fail-closed for writes. Empty token locks /api/admin writes.
ADMIN_TOKEN=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
